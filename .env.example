# Copy to .env for local use, or set these on your host.

# Required in production: the shared password you and your friends use to open the board.
# (Without it a production server refuses to serve anything.)
AGENTBOARD_PASSWORD=

# Where the SQLite database lives. Defaults to ./prisma/dev.db; the Docker image uses /data.
# DATABASE_URL=file:/data/agentboard.db

# Optional: a GitHub token (pull requests + contents: read/write on the board's repos)
# so "Approve & Merge" can merge agent PRs from the board. Without it, merge on GitHub.
# GITHUB_TOKEN=

# Optional: lets /api/webhooks accept requests (with a matching X-Webhook-Secret header)
# without logging in. When unset, webhooks require a logged-in session.
# WEBHOOK_SECRET=
